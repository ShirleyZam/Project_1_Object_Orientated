#include <iostream>
#include <string>
#include "student.h"

using namespace std;

int main() {
    string name;
    int numCourses;

    cout << "Enter student's full name: ";
    getline(cin, name);

    Student student(name);

    cout << "How many courses did " << name << " take? (1–10): ";
    cin >> numCourses;
    cin.ignore();

    while (cin.fail() || numCourses < 1 || numCourses > 10) {
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        cerr << "Invalid input. Enter a number between 1 and 10: ";
        cin >> numCourses;
        cin.ignore();
    }

    for (int i = 0; i < numCourses; ++i) {
        string courseName, letterGrade;
        int creditHours;

        cout << "Course " << i + 1 << " name: ";
        getline(cin, courseName);

        cout << "Credit hours for " << courseName << ": ";
        cin >> creditHours;
        cin.ignore();

        while (cin.fail() || creditHours < 0) {
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            cerr << "Invalid input. Enter a non-negative number: ";
            cin >> creditHours;
            cin.ignore();
        }

        cout << "Letter grade for " << courseName << ": ";
        cin >> letterGrade;
        cin.ignore();

        // You can add a validation loop here using student.getGradePoint(letterGrade)

        Course course(courseName, creditHours, letterGrade);
        student.addCourse(course);
    }
    

    // Print transcript
    cout << "\n================ Student Grade Report ================\n";
    cout << "Student: " << student.getName() << "\n\n";
    cout << "Course        Credits   GradePts   TotalPts\n";
    cout << "------------------------------------------\n";

    double totalPoints = 0;
    int totalCredits = 0;

    for (const Course& c : student.getCourses()) {
        double gp = student.getGradePoint(c.getLetterGrade());
        double tp = gp * c.getCreditHours();

        cout << c.getName() << "     "
             << c.getCreditHours() << "         "
             << gp << "       "
             << tp << "\n";

        totalPoints += tp;
        totalCredits += c.getCreditHours();
    }

    double gpa = student.calculateGPA();
    cout << "\nTotal Credits:          " << totalCredits << "\n";
    cout << "Total Points:           " << totalPoints << "\n";
    cout << "Semester GPA:           " << gpa << "\n";

    if (gpa >= 3.7)
        cout << "Standing:               Dean's List\n";
    else if (gpa >= 2.0)
        cout << "Standing:               Good Standing\n";
    else
        cout << "Standing:               Probation\n";

    return 0;
}

